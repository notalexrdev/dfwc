# dfwc "paper" theme for mako notifications.
# dfwc's default config uses this when you have no ~/.config/mako/config.

font=monospace 10
background-color=#ffffff
text-color=#1a1a1a
border-color=#d6d6d6
border-size=1
border-radius=0
padding=12
margin=12
width=360
default-timeout=5000

[urgency=high]
border-color=#d77c79
default-timeout=0
